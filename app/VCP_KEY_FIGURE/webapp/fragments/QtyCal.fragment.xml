<core:FragmentDefinition xmlns:form="sap.ui.layout.form" xmlns="sap.m"
   xmlns:sf="sap.ui.comp.smartform"
   xmlns:core="sap.ui.core"
   xmlns:smartmultiedit="sap.ui.comp.smartmultiedit">
   <Dialog title="EditMultiple" class="sapUiContentPadding" id="qtyDialogKFM" contentWidth="15rem" horizontalScrolling="false" titleAlignment="Center">
      <content>
      <form:SimpleForm >
      <form:content>
      <VBox >
      <Label text="Key Figure ID :"></Label>
      <Input id="Key_ID_QKFM"  type="Number"  required="true" enabled="{= ${gModel>/isCreateQ} }"></Input>
      </VBox>
       <VBox >
      <Label text="Key Figure Name :"></Label>
      <Input id="KeY_Fig_NameqKFM" type="Text" required="true"></Input>
      </VBox>
      <VBox >
      <Label text="Key Figure Desc :"></Label>
      <Input id="KeY_Fig_DeschKFM" type="Text" required="true"></Input>
      </VBox>
      
      </form:content>
      </form:SimpleForm>
      </content>
      <buttons>
         <Button id="idBtnQCKFM" text="Update" press="onDialogSaveButton" type="Emphasized"/>
         <Button text="Cancel" press="onCloseQCDialog"/>
      </buttons>
   </Dialog>
</core:FragmentDefinition>