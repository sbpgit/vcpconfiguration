<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<SelectDialog id="demand" title="Demand Location" multiSelect="true" rememberSelections="true"  search="handleSearch" liveChange="handleSearch"
		confirm="handleSelection" cancel="handleClose"   contentWidth="420px" items="{/aItems}" 
        selectionChange="handleProdChange" growing="true">
		<StandardListItem title="{= ${DEMAND_LOC} ? ${DEMAND_LOC}:${LOCATION_ID} }" description="{=${DEMAND_DESC} ? ${DEMAND_DESC}:${LOCATION_DESC}}" type="Active"/>
	</SelectDialog>
</core:FragmentDefinition>

