                                            enabled="{path:'PARAMETER_ID', formatter: '.formatter.getInputEnabled'}"
                                            visible="{ path: 'PARAMETER_ID', formatter: '.formatter.handleVisibility' }"
                                            valueHelpOnly="true"
                                            type="{= ${UNIT} === 'Weeks' ? 'Number' : 'Text'}"
                                            liveChange="onParamValueChange"
                                            valueHelpRequest="handleValueHelpRequest"
                                            class="sapUiTinyMarginEnd"
