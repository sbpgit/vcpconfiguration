<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<SelectDialog id="planning" title="Planning Location" rememberSelections="true" search="handleSearch" liveChange="handleSearch"
		confirm="handleSelection" cancel="handleClose" multiSelect="true"  contentWidth="420px" items="{/aItems}" 
        selectionChange="handleProdChange" growing="false">
		<StandardListItem title="{= ${PLAN_LOC} ? ${PLAN_LOC}:${LOCATION_ID} }" description="{= ${PLANLOC_DESC} ? ${PLANLOC_DESC}:${LOCATION_DESC} }" type="Active"/>
	</SelectDialog>
</core:FragmentDefinition>