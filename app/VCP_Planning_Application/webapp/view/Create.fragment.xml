<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id ="create" title="Create" contentWidth="300px" >
       <VBox class="sapUiSmallMargin" >
       <Label labelFor="dem" text="Demand Location"></Label>
       <MultiInput id="dem" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp"></MultiInput>
       <Label labelFor="prodt" text="Product"></Label>
       <MultiInput id="prodt" showValueHelp="true"  valueHelpOnly="true" valueHelpRequest="handleValueHelp"></MultiInput>
       <Label labelFor="pln" text="Planning Location"></Label>
       <MultiInput id="pln" showValueHelp="true"  valueHelpOnly="true" valueHelpRequest="handleValueHelp"></MultiInput>
       <Label labelFor="fct" text="Factory Location"></Label>
       <MultiInput id="fct" showValueHelp="true"  valueHelpOnly="true" valueHelpRequest="handleValueHelp"></MultiInput>
       </VBox>
        <beginButton>
            <Button text="Save" type="Emphasized" press="onSave"/>
        </beginButton>
        <endButton>
        <Button text="Cancel" press="onCancel" ></Button>
        </endButton>
    </Dialog>
</core:FragmentDefinition>