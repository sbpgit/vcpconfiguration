<mvc:View
    xmlns:f2="sap.f"
    controllerName="vcpapp.vcpplanningapps1.controller.Home"
    xmlns:smarttable="sap.ui.comp.smarttable"
    xmlns:smartfilterbar="sap.ui.comp.smartfilterbar"
    xmlns:dnd="sap.ui.core.dnd"
    xmlns:ux="sap.uxap"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:l="sap.ui.layout"
    xmlns:layout="sap.ui.layout"
    xmlns:unified="sap.ui.unified"
    xmlns:f="sap.ui.layout.form"
    xmlns:s="sap.f"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <s:DynamicPage
        id="Home"
        showFooter="true"
        headerExpanded="{/headerExpanded}"
        toggleHeaderOnTitleClick="{/titleClickable}"
    >
        <s:title>
            <s:DynamicPageTitle>
                <s:actions>
                    <Button
                        text="Change Logs"
                        class="iconTabBarRightBtn"
                        icon="sap-icon://history"
                        id="idChangeLogsBtn"
                        press="onChangeLogsPress"
                        type="Transparent"
                    />
                </s:actions>
                <s:actions>
                    <Button
                        class="classHdr"
                        icon="sap-icon://sys-help"
                        id="idNav3PRD"
                        press="onNavPress"
                        type="Emphasized"
                        tooltip="Help Document"
                    />
                </s:actions>
            </s:DynamicPageTitle>
        </s:title>

        <s:content>
            <!-- <VBox> -->
            <!-- IconTabBar with right-aligned Change Logs tab -->
            <IconTabBar
                id="idIconTabBarFiori2"
                stretchContentHeight="true"
                expanded="{device>/isNoPhone}"
                class="sapUiResponsiveContentPadding customIconTabBar"
                select="onSelect"
            >
                <items>
                    <!-- Left tabs -->
                    <IconTabFilter
                        text="Global Configuration"
                        key="Config1"
                    >
                        <content>
                            <VBox class="formContainer">
                                <f:SimpleForm
                                    layout="ResponsiveGridLayout"
                                    editable="true"
                                    class="customForm"
                                >
                                    <f:content>
                                        <Label text="Seed Order Series" />
                                        <Input id="idSeedOrderSeriesPC" />
                                        <Label text="Seed Order Prefix" />
                                        <Input id="idSeedOrderPrefixPC" />
                                        <Label text="IBP Planning Area" />
                                        <Input id="idIBPPlanAreaPC" />
                                        <Label text="PIR Plan Req" />
                                        <Input id="idPirPlanReq" />
                                        <Label text="IBP Prefix" />
                                        <Input id="idIBPPrefixPC" />
                                        <Label text="IBP Default Version" />
                                        <Input id="Version" />
                                        <Label text="IBP Default Scenario" />
                                        <Input id="Scenario" />

                                        <Label text="" />
                                        <CheckBox
                                            id="idValidityPC"
                                            text="Generate Unique ID Validity by Rules"
                                            select="handleChange"
                                        />
                                        <Label text="" />
                                        <CheckBox
                                            id="idPvsnode"
                                            text="PVS Node Configuration"
                                            select="handleChange"
                                        />
                                        <Label text="" />
                                        <CheckBox
                                            id="idPInterMediateAssem"
                                            text="Intermediate Assembly"
                                            select="handleChange"
                                        />

                                        <core:Title text="Telescopic Periods" />
                                        <Label
                                            text="Weekly display"
                                            labelFor="idWeek"
                                        />
                                        <Input
                                            id="idWeek"
                                            liveChange="onLiveChangeNumberOnly"
                                        />
                                        <Text text="Months" />
                                        <Label
                                            text="Monthly display"
                                            labelFor="idmonth"
                                        />
                                        <Input
                                            id="idmonth"
                                            liveChange="onLiveChangeNumberOnly"
                                        />
                                        <Text text="Months" />
                                        <Label
                                            text="Quarterly display"
                                            labelFor="idQuart"
                                        />
                                        <Input
                                            id="idQuart"
                                            liveChange="onLiveChangeNumberOnly"
                                        />
                                        <Text text="Months" />
                                    </f:content>
                                </f:SimpleForm>

                                <VBox
                                    class="buttonSection"
                                    alignItems="End"
                                >
                                    <Button
                                        width="100px"
                                        text="Save"
                                        type="Success"
                                        class="saveButton"
                                        press="onSaveConfiguration"
                                    />
                                </VBox>
                            </VBox>
                        </content>
                    </IconTabFilter>

                    <IconTabFilter
                        text="Location Configuration"
                        key="Config2"
                    >
                        <Bar>
                            <contentLeft>
                                <HBox height="30px">
                                    <Button
                                        id="leftMenu"
                                        icon="sap-icon://menu2"
                                        tooltip="Side Menu Expand/Collapse"
                                        press="expandBegin"
                                        type="Transparent"
                                        class="oMenu"
                                    />
                                    <Title
                                        text="Locations"
                                        class="title"
                                    />
                                </HBox>
                            </contentLeft>
                        </Bar>
                        <content>
                            <f2:FlexibleColumnLayout id="fcl" />
                        </content>
                    </IconTabFilter>

                    <IconTabFilter
                        text="Network Maintenance"
                        key="Network"
                    >
                        <content>
                            <layout:VerticalLayout>
                                <VBox class="NetworkFieldCSS">
                                    <Label text="" />
                                    <SearchField
                                        id="headSearch"
                                        width="250px"
                                        liveChange="handleSearch1"
                                        placeholder="Location/Product"
                                    />
                                </VBox>
                            </layout:VerticalLayout>
                            <layout:VerticalLayout>
                                <VBox class="NetworkFieldCSS">
                                    <Label
                                        text="Demand Location"
                                        labelFor="dloc"
                                    />
                                    <MultiInput
                                        id="dloc"
                                        width="250px"
                                        showValueHelp="true"
                                        valueHelpOnly="true"
                                        valueHelpRequest="handleValueHelp"
                                    />
                                </VBox>
                            </layout:VerticalLayout>
                            <layout:VerticalLayout>
                                <VBox class="NetworkFieldCSS">
                                    <Label
                                        text="Factory Location"
                                        labelFor="floc"
                                    />
                                    <MultiInput
                                        id="floc"
                                        width="250px"
                                        showValueHelp="true"
                                        valueHelpOnly="true"
                                        valueHelpRequest="handleValueHelp"
                                    />
                                </VBox>
                            </layout:VerticalLayout>
                            <layout:VerticalLayout>
                                <VBox class="NetworkFieldCSS">
                                    <Label
                                        text="Product"
                                        labelFor="prod"
                                    />
                                    <MultiInput
                                        id="prod"
                                        width="250px"
                                        showValueHelp="true"
                                        valueHelpOnly="true"
                                        valueHelpRequest="handleValueHelp"
                                    />
                                </VBox>
                            </layout:VerticalLayout>
                            <layout:VerticalLayout>
                                <HBox class="NetworkFieldCSS">
                                 <Label text="" />
                                    <Button
                                        text="Go"
                                        type="Emphasized"
                                        press="onGetData"
                                         class="sapUiSmallMarginTop"
                                    />
                                   <Label text="" />
                                    <Button
                                        text="Reset"
                                        type="Transparent"
                                        press="onResetData"
                                         class="sapUiSmallMarginTop"
                                    />
                                </HBox>
                            </layout:VerticalLayout>
                        </content>
                        <content>
                            <Page
                                showFooter="true"
                                showHeader="false"
                            >
                                <Table
                                    id="orderList"
                                    sticky="ColumnHeaders"
                                    mode="MultiSelect"
                                    items="{/TableData}"
                                    itemPress="onhandlePress"
                                    selectionChange="onhandlePress"
                                >
                                    <headerToolbar>
                                        <Toolbar>
                                            <content>
                                                <ToolbarSpacer />
                                                <Button
                                                    text="Create"
                                                    id="oNewcreate"
                                                    press="onCreateJob"
                                                />
                                                <Button
                                                    text="Copy"
                                                    id="copy"
                                                    press="onCopy"
                                                    enabled="false"
                                                />
                                                <Button
                                                    text="Delete"
                                                    id="delete"
                                                    press="onDelete"
                                                    enabled="false"
                                                />
                                            </content>
                                        </Toolbar>
                                    </headerToolbar>
                                    <columns>
                                        <Column
                                            hAlign="Left"
                                            vAlign="Middle"
                                            minScreenWidth="Tablet"
                                            demandPopin="true"
                                        >
                                            <Text text="Location/Desc." />
                                        </Column>
                                        <Column
                                            hAlign="Left"
                                            vAlign="Middle"
                                            minScreenWidth="Tablet"
                                            demandPopin="true"
                                        >
                                            <Text text="Product/Desc." />
                                        </Column>
                                        <Column
                                            hAlign="Left"
                                            vAlign="Middle"
                                            minScreenWidth="Tablet"
                                            demandPopin="true"
                                        >
                                            <Text
                                                text="Planning Location/Desc."
                                            />
                                        </Column>
                                        <Column
                                            hAlign="Left"
                                            vAlign="Middle"
                                            minScreenWidth="Tablet"
                                            demandPopin="true"
                                        >
                                            <Text
                                                text="Factory Location/Desc."
                                            />
                                        </Column>
                                        <Column
                                            width="5rem"
                                            hAlign="Left"
                                            vAlign="Middle"
                                        >
                                            <Text text="" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem class="scroll">
                                            <cells>
                                                <ObjectIdentifier
                                                    text="{DEMAND_LOC}"
                                                    title="{DEMAND_DESC}"
                                                />
                                                <ObjectIdentifier
                                                    text="{PRODUCT_ID}"
                                                    title="{PROD_DESC}"
                                                />
                                                <ObjectIdentifier
                                                    text="{PLAN_LOC}"
                                                    title="{PLANLOC_DESC}"
                                                />
                                                <ObjectIdentifier
                                                    text="{FACTORY_LOC}"
                                                    title="{LOCATION_DESC}"
                                                />
                                                <Button
                                                    icon="sap-icon://navigation-right-arrow"
                                                    press="onNavigate"
                                                    type="Default"
                                                    tooltip="Go to more details"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </Page>
                        </content>
                    </IconTabFilter>
                    <!-- <IconTabSeparator ></IconTabSeparator> -->

                    <!-- Right-aligned Change Logs tab -->
                    <!-- <IconTabFilter
                        text="Change Logs"
                        key="Logs"
                        class="rightTabBtn"
                    /> -->
                </items>
            </IconTabBar>
            <!-- <VBox> -->
            <!-- <Button
                    id="idChangeLogsBtn"
                    text="Change Logs"
                    icon="sap-icon://history"
                    type="Transparent"
                    press="onChangeLogsPress"
                    class="iconTabBarRightBtn"
                /> -->
            <!-- </VBox> -->
            <!-- </VBox> -->
        </s:content>
    </s:DynamicPage>
</mvc:View>
