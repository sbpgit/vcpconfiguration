{
    "_version": "1.58.0",
    "sap.app": {
        "id": "vcpapp.vcpdynamicfrozenfirm",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "2512.01.01"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:lrop",
            "version": "1.11.4",
            "toolsId": "9bad74d4-c801-4f97-99a7-4f8da9f4a598"
        },
        "dataSources": {
            "mainService": {
                "uri": "/v2/catalog/",
                "type": "OData",
                "settings": {
                    "annotations": [
                        "annotation"
                    ],
                    "localUri": "localService/metadata.xml",
                    "odataVersion": "2.0"
                }
            },
            "secondService": {
                "uri": "/v2/catalog/",
                "type": "OData",
                "settings": {
                    "annotations": [
                        "annotation"
                    ],
                    "localUri": "localService/metadata.xml",
                    "odataVersion": "2.0"
                }
            },
            "annotation": {
                "type": "ODataAnnotation",
                "uri": "annotations/annotation.xml",
                "settings": {
                    "localUri": "annotations/annotation.xml"
                }
            }
        },
        "crossNavigation": {
            "inbounds": {
                "vcp_dynamic-display": {
                    "semanticObject": "vcp_dynamic",
                    "icon": "sap-icon://company-view",
                    "action": "display",
                    "title": "{{flpTitle}}",
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    }
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "sap-icon://company-view",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.120.41",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ushell": {},
                "sap.f": {},
                "sap.ui.comp": {},
                "sap.ui.generic.app": {},
                "sap.suite.ui.generic.template": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "vcpapp.vcpdynamicfrozenfirm.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "defaultBindingMode": "TwoWay",
                    "defaultCountMode": "Inline",
                    "refreshAfterChange": false,
                    "metadataUrlParams": {
                        "sap-value-list": "none"
                    }
                }
            },
            "oModel": {
                "dataSource": "secondService",
                "preload": false,
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            },
            "oGModel": {
                "type": "sap.ui.model.json.JSONModel",
                "settings": {
                    "defaultBindingMode": "TwoWay"
                },
                "preload": true
            },
            "@i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "uri": "i18n/i18n.properties"
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {},
            "routes": [],
            "targets": {}
        },
        "extends": {
            "extensions": {
                "sap.ui.controllerExtensions": {
                    "sap.suite.ui.generic.template.ListReport.view.ListReport": {
                        "controllerName": "vcpapp.vcpdynamicfrozenfirm.ext.controller.ListReportExt",
                        "sap.ui.generic.app": {
                            "getDynHorizonGrpData": {
                                "EntitySet": "getDynHorizonGrpData",
                                "Actions": {
                                    "idCreate": {
                                        "id": "idCreateButtonDFF",
                                        "text": "Create",
                                        "press": "onCustomAction",
                                        "requiresSelection": false
                                    },
                                    "iddownloaddbtn": {
                                        "id": "iddownloadDFF",
                                        "text": "Download",
                                        "press": "onDownload",
                                        "requiresSelection": false
                                    },
                                    "iduploadbtn": {
                                        "id": "iduploadbtnDFF",
                                        "text": "Upload",
                                        "press": "onupload",
                                        "requiresSelection": false
                                    },
                                    "idDelete": {
                                        "id": "idDeleteButtonDFF",
                                        "text": "Delete",
                                        "press": "onDeletePress",
                                        "requiresSelection": true
                                    },
                                    "idHelp": {
                                        "id": "idHelpButtonDFF",
                                        "text": "Help",
                                        "press": "onHelp",
                                        "global": true
                                    }
                                }
                            }
                        }
                    },
                    "sap.suite.ui.generic.template.ObjectPage.view.Details": {
                        "controllerName": "vcpapp.vcpdynamicfrozenfirm.ext.controller.ObjectPageExt",
                        "sap.ui.generic.app": {
                            "getDynHorizonGrpData": {
                                "EntitySet": "getDynHorizonGrpData",
                                "Header": {
                                    "Actions": {
                                        "idback": {
                                            "id": "idbackButtonDFF",
                                            "text": "Back",
                                            "press": "onback",
                                            "requiresSelection": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "sap.ui.generic.app": {
        "_version": "1.3.0",
        "settings": {
            "forceGlobalRefresh": false,
            "objectPageHeaderType": "Dynamic",
            "considerAnalyticalParameters": true,
            "showDraftToggle": false
        },
        "pages": {
            "ListReport|getDynHorizonGrpData": {
                "entitySet": "getDynHorizonGrpData",
                "component": {
                    "name": "sap.suite.ui.generic.template.ListReport",
                    "list": true,
                    "settings": {
                        "condensedTableLayout": true,
                        "smartVariantManagement": true,
                        "enableTableFilterInPageVariant": true,
                        "dataLoadSettings": {
                            "loadDataOnAppLaunch": "always"
                        },
                        "filterSettings": {
                            "dateSettings": {
                                "useDateRange": true
                            }
                        },
                        "tableSettings": {
                            "multiSelect": true
                        }
                    }
                },
                "pages": {
                    "ObjectPage|getDynHorizonGrpData": {
                        "entitySet": "getDynHorizonGrpData",
                        "defaultLayoutTypeIfExternalNavigation": "MidColumnFullScreen",
                        "component": {
                            "name": "sap.suite.ui.generic.template.ObjectPage"
                        }
                    }
                }
            }
        }
    },
    "sap.fiori": {
        "registrationIds": [],
        "archeType": "transactional"
    },
    "sap.cloud": {
        "public": true,
        "service": "vcpconfiguration"
    },
    "sap.platform.cf": {
        "oAuthScopes": [
            "$XSAPPNAME.User",
            "$XSAPPNAME.admin"
        ],
        "ui5VersionNumber": "1.120.41"
    }
}
