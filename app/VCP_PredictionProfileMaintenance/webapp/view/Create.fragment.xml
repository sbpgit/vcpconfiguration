<core:FragmentDefinition xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout"
	xmlns:u="sap.ui.unified" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
	<Dialog  contentWidth="700px" showHeader="false">
	<content>
	<VBox class="sapUiSmallMargin">
		<f:Form id="FormChange354wideDual"
			editable="true">
			<f:title>
				<core:Title id="idtitle" text="Creation of Planning Profile" />
			</f:title>
			<f:layout>
				<f:ResponsiveGridLayout
					labelSpanXL="4"
					labelSpanL="3"
					labelSpanM="4"
					labelSpanS="12"
					adjustLabelSpan="false"
					emptySpanXL="0"
					emptySpanL="4"
					emptySpanM="0"
					emptySpanS="0"
					columnsXL="2"
					columnsL="1"
					columnsM="1"
					singleContainerFullSize="false" />
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="Planning Profile">
							<f:fields>
								<Input value="" id="idPlanProfPPM" maxLength="12" liveChange="checkspecialChars"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Clustering Profile">
							<f:fields>
								<Input value="" id="clusterPlanPPM" placeholder="Clustering Profile" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp"/>								
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Min Primary IDs">
							<f:fields>
								<Input value="" id="minPidPPM" type="Number" liveChange="onValue"/>									
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Percentage of Primary IDs">
							<f:fields>
								<Input value="" id="pidPercentPPM" type="Number" liveChange="onValue"/>		
							</f:fields>
						</f:FormElement>
                        <f:FormElement label="Threshold Demand">
							<f:fields>
								<Input value="" id="threDMDPPM" type="Number" liveChange="onValue"/>		
							</f:fields>
						</f:FormElement>
                        
                        <!-- <f:FormElement label="Maximum Cluster Count">
							<f:fields>
								<Input value="" id="maxClust" type="Number"/>		
							</f:fields>
						</f:FormElement> -->
                        <!-- <f:FormElement label="Past Weeks">
							<f:fields>
								<Input value="" id="pastweekPPM" type="Number"/>		
							</f:fields>
						</f:FormElement>
                        <f:FormElement label="Future Weeks">
							<f:fields>
								<Input value="" id="futweek" type="Number"/>		
							</f:fields>
						</f:FormElement> -->
					</f:formElements>
				</f:FormContainer>

					<f:FormContainer>
						<f:FormElement label="Cluster Count">
									<f:fields>
									<HBox >
										<Input value="" id="minClustPPM" type="Number" placeholder="Minimum Value" class="sapUiMediumMarginEnd" liveChange="onValue"/>	
										<Input value="" id="maxClustPPM" type="Number" placeholder="maximum Value" liveChange="onValue"/>	
										</HBox>
									</f:fields>
								</f:FormElement>
								</f:FormContainer>
								<f:FormContainer>
						<f:FormElement label="Past Weeks">
							<f:fields>
								<Input value="156" id="pastweekPPM" type="Number" liveChange="onValue"/>		
							</f:fields>
						</f:FormElement>
                        <f:FormElement label="Future Weeks">
							<f:fields>
								<Input value="0" id="futweekPPM" type="Number" liveChange="onValue"/>		
							</f:fields>
						</f:FormElement>
								</f:FormContainer>
					</f:formContainers>
		</f:Form>
	</VBox>


    </content>
		<beginButton>
			<Button id="confirmBtnPPM" type="Accept" text="Confirm" press="onPlanningProfileSave"></Button>
		</beginButton>
		<endButton>
			<Button type="Reject" text="Cancel" press="onHandleClose"></Button>
		</endButton>
	</Dialog>
</core:FragmentDefinition>