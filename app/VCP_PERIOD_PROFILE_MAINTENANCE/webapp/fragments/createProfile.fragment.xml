<core:FragmentDefinition xmlns:microchart="sap.suite.ui.microchart" xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:micro="sap.suite.ui.microchart"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified">
    <Dialog id="idRestItem2" title="Create" contentWidth="550px" titleAlignment="Center">
           
                
        <VBox class="sapUiSmallMargin">
            <f:SimpleForm id="SimpleFormToolbaritem2" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="4" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false">
                <f:content>

                    
                    <Label required="true" text="Profile"/>
                    <Input id="idProfile" value="" width="225px" maxLength="50"  placeholder="Profile"  type="Text" />
                    <Label required="true" text="Profile Desc"/>
                    <Input id="idProfDesc" value="" width="225px" maxLength="100" placeholder="Profile Desc" type="Text"  />
                    
                  
                    <Label required="true" text="Weekly" />
                    <Input id="idWeek" value="0" liveChange="onSelMonth"  placeholder="0 - 104" type="Number" visible="true"/>
                    <Text text="Weeks" textAlign="Begin" visible="true" />
                    
                    <Label  required="true" text="Monthly" />
                    <Input id="idMonth" value="0"  liveChange="onSelMonth" placeholder="0 - 104"  type="Number" visible="true"/>
                    <Text text="Weeks" textAlign="Begin" visible="true" />

                    <Label required="true" text="Quarterly" />
                    <Input id="idQuarter" value="0"  liveChange="onSelMonth" placeholder="0 - 104"  type="Number" visible="true"/>
                    <Text text="Weeks" textAlign="Begin" visible="true" />
