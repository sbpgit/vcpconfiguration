                </f:content>
            </f:SimpleForm>
        </VBox>
   <Panel >
        <micro:StackedBarMicroChart size="Responsive" class="margin" width="400px" >
								<micro:bars>
									<micro:StackedBarMicroChartBar id="idWeekly" displayValue="0 Weekly" value="0"/>
									<micro:StackedBarMicroChartBar id="idMonthly"  displayValue="0 Monthly" value="0"/>
									<micro:StackedBarMicroChartBar id="QuarterID"  displayValue="0 Quarterly" value="0"/>
								</micro:bars>
                                
							</micro:StackedBarMicroChart>
                            <HBox >
                               <Text text="0" id="idTotal"  ></Text>
                            </HBox>
                          
                            </Panel>
                           
          
       
            
         
       
     
     
        <buttons>
            
            <Button id="idAdd" text="Save" press="onSave" type="Emphasized"/>
            <Button type='Reject' text="Close" press="onClose"></Button>
        </buttons>
    </Dialog>
</core:FragmentDefinition>